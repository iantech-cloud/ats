{
  "name": "workspace",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');const ua=process.env.npm_config_user_agent||'';if(!ua.startsWith('pnpm/')){console.error('ERROR: Please use pnpm instead of npm or yarn');process.exit(1)}['package-lock.json','yarn.lock'].forEach(f=>{try{fs.unlinkSync(f)}catch(e){}})\"",

    "dev": "pnpm -r --parallel --if-present run dev",

    "build": "pnpm run clean && pnpm run typecheck && pnpm -r --if-present run build",

    "typecheck": "tsc --build --force && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",

    "lint": "pnpm -r --if-present run lint",

    "clean": "pnpm -r --if-present run clean && node -e \"const fs=require('fs');['dist','.turbo','.next','coverage'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\"",

    "start": "pnpm -r --parallel --if-present run start",

    "rebuild": "pnpm install --force && pnpm run build",

    "format": "prettier . --write",

    "check-format": "prettier . --check"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "prettier": "^3.8.1"
  }
}